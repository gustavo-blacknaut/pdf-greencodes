{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF.GreenCodes",
  "version": "4.1.0",
  "identifier": "br.com.greencodes.pdf",
  "build": {
    "frontendDist": "../out",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "principal",
        "title": "PDF.GreenCodes",
        "url": "app",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost blob: data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icone.ico"
    ],
    "resources": {
      "../motor/principal.py": "motor/principal.py",
      "../motor/motor/": "motor/motor/",
      "../motor/runtime/": "motor/runtime/",
      "../impressora/impressora.exe": "impressora/impressora.exe"
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "Documento PDF",
        "description": "Abrir no PDF.GreenCodes",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icone.ico",
        "startMenuFolder": "PDF.GreenCodes"
      }
    }
  }
}
