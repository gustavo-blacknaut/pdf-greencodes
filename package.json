{
  "name": "pdf-greencodes",
  "version": "4.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node servidor.js",
    "preview": "npx serve out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "app:dev": "tauri dev",
    "app:build": "node scripts/conferir-motor.mjs && tauri build",
    "tauri": "tauri",
    "deploy": "bash scripts/instalar-site.sh",
    "publicar-app": "node scripts/publicar-app.mjs",
    "tamanho": "node scripts/verificar-tamanho.js",
    "verificar": "npm run tamanho && npm run typecheck && npm run test && npm run rust",
    "rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "impressora": "node scripts/compilar-impressora.js",
    "motor": "motor\\runtime\\python.exe -m pytest motor/testes -q",
    "preparar-motor": "node scripts/preparar-motor.mjs",
    "conferir-motor": "node scripts/conferir-motor.mjs",
    "provar-impressao": "node scripts/provar-impressao.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.8.1",
    "@tauri-apps/api": "^2.11.1",
    "heic-to": "^1.5.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "next": "^16.3.3",
    "pdfjs-dist": "^4.10.38",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "description": "Ferramentas de PDF que rodam inteiras no navegador. Sem upload, sem servidor, sem conta."
}
