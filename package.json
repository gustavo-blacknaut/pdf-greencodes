{
  "name": "pdf-greencodes",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 5069",
    "preview": "npx serve out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "app:dev": "npm run build && electron .",
    "app:build": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.8.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "next": "^16.3.3",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "description": "Ferramentas de PDF que rodam inteiras no navegador. Sem upload, sem servidor, sem conta.",
  "main": "electron/main.js",
  "build": {
    "appId": "br.com.greencodes.pdf",
    "productName": "PDF.GreenCodes",
    "copyright": "GreenCodes",
    "directories": {
      "output": "dist-app",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icone.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF.GreenCodes",
      "deleteAppDataOnUninstall": true
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Documento PDF",
        "role": "Editor",
        "description": "Abrir no PDF.GreenCodes"
      }
    ]
  }
}
